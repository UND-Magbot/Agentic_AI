VLLM_BASE_URL=http://localhost:8001
VLLM_API_KEY=
MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
PORT=8000
CORS_ORIGINS=http://localhost:3010
# 응답 최대 토큰. max_model_len(4096) 안에서 입력 budget 과 함께 동적 조정된다.
# 기본 1024 — 한국어 답변 1~2 단락이 잘리지 않는 수준. 너무 작으면 본문이 mid-sentence 로 끊긴다.
MAX_TOKENS=1024
# Tavily 외부 검색 (https://tavily.com — 무료 1k/월). 빈 값이면 검색 도구가 비활성.
TAVILY_API_KEY=
