# ============================================================
# UND Cortex — 환경 변수 예시
# 사용법: 이 파일을 .env로 복사 후 값을 채운다. .env는 절대 커밋하지 않는다.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=cortex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cortex
# 로컬 DB(--profile local-db) 새 볼륨 초기화 시 시드 사용자 비밀번호. 반드시 강한 값으로 설정.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=change-me

# --- MinIO ---
MINIO_ROOT_USER=cortex
MINIO_ROOT_PASSWORD=change-me-min-8

# --- 인증/JWT ---
# 반드시 32바이트 이상의 강한 랜덤 값으로 교체. 기본 플레이스홀더면 백엔드가 부팅을 거부한다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-256bit-secret
JWT_EXPIRES_IN=30m

# --- 내부 서비스 토큰 (BFF → Agent 보호) ---
# frontend(BFF) 만 backend /v1/generate·/v1/title 를 호출하도록 식별하는 공유 토큰.
# 비어 있으면 가드 비활성(개발). 운영에서는 강한 랜덤 값으로 설정 권장.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=

# --- LLM provider ---
# vllm(기존 Qwen) | ollama(Gemma 등으로 이전). ollama 로 두면 OLLAMA_* 사용, vllm 무시.
LLM_PROVIDER=vllm
# Ollama(UND-AI 등 GPU 서버). 외부 호출하려면 서버를 OLLAMA_HOST=0.0.0.0 으로 띄워야 함.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
# 제안서 기능 전용 모델(품질 우선, 사고 모드). 공용 모델과 따로 둔다.
PROPOSAL_MODEL=gemma4:26b-a4b-it-qat
PROPOSAL_THINK=1
# 회사 제품 추천만 다른 사내 모델로(비우면 PROPOSAL_MODEL 을 따른다).
RECOMMEND_MODEL=

# --- vLLM (LLM_PROVIDER=vllm 일 때) ---
# host.docker.internal: 컨테이너 → 호스트 vLLM. GPU 호스트가 별도면 해당 IP/포트로 변경.
VLLM_BASE_URL=http://host.docker.internal:8001
# ─────────────────────────────────────────────────────────────────────────
# MODEL — vLLM 가 서빙할 모델. 변경 시 컨테이너에서 첫 기동에 모델 다운로드.
#   현재 기본:  Qwen/Qwen2.5-7B-Instruct-AWQ        (다국어, AWQ ~5GB VRAM)
#
# 한국어 특화 후보 (택1):
#   - MLP-KTLim/llama-3-Korean-Bllossom-8B          (한국어 강, FP16 ~16GB)
#       → VLLM_QUANTIZATION=none 또는 미설정
#   - LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct          (LG AI, FP16 ~16GB)
#       → VLLM_QUANTIZATION=none, HF_TOKEN 필요(약관 동의)
#   - upstage/SOLAR-10.7B-Instruct-v1.0             (한국어 + 영어, FP16 ~22GB)
#       → VLLM_QUANTIZATION=none
#   - TheBloke/SOLAR-10.7B-Instruct-v1.0-AWQ        (Solar AWQ ~6GB VRAM)
#       → VLLM_QUANTIZATION=awq_marlin
#
# 양자화 전략:
#   - VRAM ≥ 24GB : FP16 모델 직접 사용 (VLLM_QUANTIZATION=none)
#   - VRAM 6~12GB : AWQ/GPTQ 양자화 모델 (VLLM_QUANTIZATION=awq_marlin 또는 gptq_marlin)
# ─────────────────────────────────────────────────────────────────────────
MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_QUANTIZATION=awq_marlin
MAX_TOKENS=1024
MAX_MODEL_LEN=4096
# Sampling — 한국어 instruction-following 강화 + 다국어 fallback 억제.
VLLM_TEMPERATURE=0.1
VLLM_TOP_P=0.7
VLLM_REPETITION_PENALTY=1.15
# 응답 후반부에서 모델이 빈 토큰 자리를 다른 언어/주제로 채우는 행동을 억제.
VLLM_PRESENCE_PENALTY=0.3
VLLM_FREQUENCY_PENALTY=0.5

# Hugging Face 토큰 (vllm 컨테이너로 모델 다운로드 시 필요)
HF_TOKEN=

# --- 외부 검색 ---
TAVILY_API_KEY=

# --- 외부 LLM (보안 등급 P 한정) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 라우팅 정책 ---
# S/C/P 중 외부 LLM이 허용되는 등급 (기본: P만)
ALLOW_EXTERNAL_LLM_FOR=P

# --- Backend ---
CORS_ORIGINS=http://localhost:3010

# --- 공휴일 API (자금계획 영업일 보정) ---
# 한국천문연구원_특일 정보(data.go.kr). 회원가입 → "활용신청" → 일반 인증키(Decoding) 붙여넣기.
# 비워두면 검증된 정적 공휴일 세트로 폴백(오프라인 동작). 대체공휴일은 API가 포함해 내려줌.
HOLIDAY_API_KEY=

# --- Frontend ---
# 인증 도입 전 임시. 빈 상태 환영 문구 등에 사용. 변경 시 frontend 재빌드 필요.
NEXT_PUBLIC_USER_NAME=UND

# ── Codex 브리지 (docker-codeserver/codex-bridge) ──
# 웹 검색·이미지 생성·심층 분석을 Codex 에 위임. URL/TOKEN 이 비면 비활성.
# TOKEN 은 docker-codeserver/.env 의 CODEX_BRIDGE_TOKEN 과 같은 값.
CODEX_BRIDGE_URL=http://host.docker.internal:10120
CODEX_BRIDGE_TOKEN=
# search_web 제공자: codex | tavily (codex 실패 시 TAVILY_API_KEY 가 있으면 Tavily 로 폴백)
SEARCH_PROVIDER=tavily
# 사내 자료(RAG 발췌)를 Codex(OpenAI)로 보낼지 여부 — 사내 데이터 외부 반출이므로 기본 false
CODEX_ALLOW_INTERNAL_DATA=false

# 다른 PC 에서 접속 허용할 이 PC 의 LAN IP (쉼표 구분)
ALLOWED_DEV_ORIGINS=

# --- 운영 서버(docker-compose.server.yml) ---
# Caddy 가 HTTPS 인증서를 발급받을 공개 도메인. CORS_ORIGINS 에도 https://<도메인> 을 넣는다.
PUBLIC_DOMAIN=
